# ==============================================================================
# Greenart Properties — Land Market Rate Analyst
# Environment Variables Template (.env.example)
#
# COPY THIS FILE TO .env FOR LOCAL OVERRIDES.
# NEVER COMMIT ACTUAL SECRETS OR PRODUCTION VALUES TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (.NET 8 Web API)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# PostgreSQL + PostGIS Connection
# Format: Host=localhost;Port=5432;Database=greenart_dev;Username=postgres;Password=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=greenart_dev
DB_USER=greenart_user
DB_PASSWORD=replace_with_secure_local_dev_password

# Authentication & JWT (For local development only)
JWT_ISSUER=greenart.group
JWT_AUDIENCE=greenart-clients
JWT_SECRET_KEY=replace_with_minimum_32_character_random_secret_key_for_dev

# Geocoding & Locality Search Proxy (Google Maps Places API New)
# Kept server-side only in ASP.NET Core backend to prevent frontend leakage
GEOCODING_API_BASE_URL=https://places.googleapis.com/v1
GEOCODING_API_KEY=replace_with_geocoding_api_key
GEOCODING_DEFAULT_REGION=in

# Allowed CORS Origins (Comma-separated)
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# LandLens API Integration (Tamil Nadu Land Parcel & Guideline Engine)
# Base URL defaults to https://verified.realestate/api/v1
LANDLENS_BASE_URL=https://verified.realestate/api/v1
LANDLENS_API_KEY=replace_with_landlens_api_key
LANDLENS_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Business Gmail / SMTP Configuration (Transactional & OTP Email Delivery)
# ------------------------------------------------------------------------------
# For Google Workspace / Business Gmail:
# 1. Enable 2-Step Verification on your Google Workspace / Gmail account.
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# 3. Enter the 16-character password into SMTP_PASSWORD (spaces automatically handled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your_business_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_business_email@gmail.com
SMTP_FROM_NAME="Greenart Properties"

# ------------------------------------------------------------------------------
# Customer Mobile Application (Expo / React Native)
# ------------------------------------------------------------------------------
# In Expo SDK 49+, variables prefixed with EXPO_PUBLIC_ are exposed to the client
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_MAP_PROVIDER=osm

# ------------------------------------------------------------------------------
# Admin Web Application (React + Vite)
# ------------------------------------------------------------------------------
# In Vite, variables prefixed with VITE_ are exposed to the client
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE="Greenart Properties Admin"

