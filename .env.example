# ==============================================================================
# Greenart Properties — Land Market Rate Analyst
# Environment Variables Template (.env.example)
#
# COPY THIS FILE TO .env FOR LOCAL OVERRIDES.
# NEVER COMMIT ACTUAL SECRETS OR PRODUCTION VALUES TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service (.NET 8 Web API / Render Cloud Service)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
PORT=5039

# Administrative Authorization
# Required in Production. Requests to administrative endpoints require X-Admin-Key matching this key.
ADMIN_API_KEY=

# Seed Admin Password (Used ONLY in Development environment by UserDataSeeder)
# In Production, user seeding is disabled entirely.
SEED_ADMIN_PASSWORD=

# PostgreSQL + PostGIS Connection
# Can be provided as ADO.NET connection string or DATABASE_URL URI (Render/Neon standard)
# Example URI: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=
# Or individual ADO components:
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Authentication & JWT
JWT_ISSUER=greenart.group
JWT_AUDIENCE=greenart-clients
JWT_SECRET_KEY=

# Geocoding & Locality Search Proxy (Google Places API New - Server-Side Only)
GEOCODING_API_BASE_URL=https://places.googleapis.com/v1
GEOCODING_API_KEY=
GEOCODING_DEFAULT_REGION=in

# LandLens API Integration (Statutory Guideline Engine - Server-Side Only)
LANDLENS_BASE_URL=https://verified.realestate/api/v1
LANDLENS_API_KEY=
LANDLENS_TIMEOUT_SECONDS=30

# Google Gemini AI (Server-Side Only for Qualitative Explanations - NEVER in Mobile App)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Transactional & OTP Email Delivery (Business Gmail / Workspace SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Greenart Properties"

# Allowed CORS Origins (Comma-separated)
ALLOWED_CORS_ORIGINS=https://admin.greenart.group,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Customer Mobile Application (Expo / React Native / EAS Secrets)
# ------------------------------------------------------------------------------
# In EAS Build, configure these under Expo Dashboard -> Project -> Secrets.
# DO NOT ADD GEMINI KEYS HERE. Gemini calls are strictly encapsulated in the backend.
EXPO_PUBLIC_API_URL=https://greenartapp-1.onrender.com/api/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAP_PROVIDER=google

# ------------------------------------------------------------------------------
# 3. Admin Web Application (React + Vite / Vercel / Cloudflare Pages)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://greenartapp-1.onrender.com/api/v1
VITE_APP_TITLE="Greenart Properties Admin"
VITE_ADMIN_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
