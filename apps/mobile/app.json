        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0E0B1F"
      },
      "package": "group.greenart.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB8mXEv9un7VEaew89x8VFO5qDAdK1CrW4"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withMonorepoPaths"
    ],
    "extra": {
      "eas": {
        "projectId": "7d2023a9-994b-4449-87bc-7d5b99deec02"
      }
    },
    "owner": "haran_hd"
